  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "TubePulse status",
      "description": "A calm summary of service health, monitoring freshness and host authority. Saturated amber or coral appears only when action is required.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 9,
        "h": 3
      },
      "targets": [
        {
          "expr": "(tubepulse_collector_collection_success * tubepulse_collector_host_collection_success * tubepulse_host_ready * tubepulse_host_authority_current * tubepulse_host_scheduler_active * tubepulse_authority_backend_ready * tubepulse_notifications_barrier_healthy * (tubepulse_host_last_error_present == bool 0) * ((time() - tubepulse_collector_last_success_timestamp_seconds) < bool 960) * (scalar(sum(tubepulse_cloudflare_worker_errors{period=\"window\"}) or vector(0)) == bool 0) * (scalar(tubepulse:d1_write_budget_ratio) < bool 0.9) * (scalar(tubepulse:worker_request_budget_ratio) < bool 0.9) * (scalar(max(tubepulse_youtube_quota_used / tubepulse_youtube_quota_limit)) < bool 0.9)) * (1 + (tubepulse_collector_cloudflare_collection_success * tubepulse_subscription_integrity_consistent * (tubepulse_authority_pending_backup_consecutive_samples < bool 2) * (tubepulse_authority_transaction_active_consecutive_samples < bool 2) * (tubepulse_notifications_durable_backlog == bool 0) * (tubepulse_notifications_callback_pending == bool 0) * (tubepulse_notifications_ambiguous_sending == bool 0) * (tubepulse_notifications_retained_failures == bool 0) * (tubepulse_notifications_failed == bool 0) * (tubepulse_youtube_last_error_present == bool 0) * ((time() - tubepulse_collector_last_success_timestamp_seconds) < bool 660) * (scalar(tubepulse:d1_write_budget_ratio) < bool 0.7) * (scalar(tubepulse:d1_read_budget_ratio) < bool 0.7) * (scalar(tubepulse:d1_write_projected_end_of_day / on() tubepulse_guardrail{resource=\"d1_rows_written_day\"}) < bool 0.7) * (scalar(tubepulse:worker_request_budget_ratio) < bool 0.7) * (scalar(max(tubepulse_youtube_quota_used / tubepulse_youtube_quota_limit)) < bool 0.7) * (scalar(sum(tubepulse_cloudflare_worker_requests{period=\"window\",script!=\"tubepulse-api\"}) or vector(0)) == bool 0)))",
          "legendFormat": "System",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "System"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Service fault",
                        "color": "#EF5350"
                      },
                      "1": {
                        "text": "Review needed",
                        "color": "#FFB74D"
                      },
                      "2": {
                        "text": "All systems normal",
                        "color": "#6FCF97"
                      }
                    }
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#EF5350",
                      "value": null
                    },
                    {
                      "color": "#FFB74D",
                      "value": 1
                    },
                    {
                      "color": "#6FCF97",
                      "value": 2
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
