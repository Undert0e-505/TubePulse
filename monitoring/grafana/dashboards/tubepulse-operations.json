    {
      "id": 2,
      "type": "stat",
      "title": "Attention",
      "description": "Quiet when no action is required. Current queues, transactions, drift, API failures, notification failures, Worker errors or legacy traffic appear here only when actionable.",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 4
      },
      "targets": [
        {
          "expr": "tubepulse_host_last_error_present + (tubepulse_authority_pending_backup_consecutive_samples >= bool 2) + (tubepulse_authority_transaction_active_consecutive_samples >= bool 2) + (1 - tubepulse_subscription_integrity_consistent) + tubepulse_youtube_last_error_present + (tubepulse_notifications_failed > bool 0) + (tubepulse_notifications_durable_backlog > bool 0) + (tubepulse_notifications_callback_pending > bool 0) + (tubepulse_notifications_ambiguous_sending > bool 0) + (scalar(sum(tubepulse_cloudflare_worker_errors{period=\"window\"}) or vector(0)) > bool 0) + (scalar(sum(tubepulse_cloudflare_worker_requests{period=\"window\",script!=\"tubepulse-api\"}) or vector(0)) > bool 0) + 1000 * (1 - (tubepulse_collector_collection_success * tubepulse_collector_host_collection_success * tubepulse_host_ready * tubepulse_host_authority_current * tubepulse_host_scheduler_active * tubepulse_authority_backend_ready * tubepulse_notifications_barrier_healthy * (tubepulse_host_last_error_present == bool 0) * ((time() - tubepulse_collector_last_success_timestamp_seconds) < bool 960) * (scalar(sum(tubepulse_cloudflare_worker_errors{period=\"window\"}) or vector(0)) == bool 0) * (scalar(tubepulse:d1_write_budget_ratio) < bool 0.9) * (scalar(tubepulse:worker_request_budget_ratio) < bool 0.9) * (scalar(max(tubepulse_youtube_quota_used / tubepulse_youtube_quota_limit)) < bool 0.9)))",
          "legendFormat": "Live checks",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "expr": "tubepulse_authority_pending_backup_keys and on() (tubepulse_authority_pending_backup_consecutive_samples >= 2)",
          "legendFormat": "D1 queue",
          "refId": "B",
          "instant": true,
          "range": false
        },
        {
          "expr": "tubepulse_authority_transaction_active and on() (tubepulse_authority_transaction_active_consecutive_samples >= 2)",
          "legendFormat": "D1 transaction",
          "refId": "C",
          "instant": true,
          "range": false
        },
        {
          "expr": "(1 - tubepulse_subscription_integrity_consistent) > 0",
          "legendFormat": "Subscription drift",
          "refId": "D",
          "instant": true,
          "range": false
        },
        {
          "expr": "tubepulse_youtube_last_error_present > 0",
          "legendFormat": "YouTube error",
          "refId": "E",
          "instant": true,
          "range": false
        },
        {
          "expr": "tubepulse_notifications_failed > 0",
          "legendFormat": "Notification failures",
          "refId": "F",
          "instant": true,
          "range": false
        },
        {
          "expr": "tubepulse_notifications_durable_backlog > 0",
          "legendFormat": "Notification backlog",
          "refId": "G",
          "instant": true,
          "range": false
        },
        {
          "expr": "(sum(tubepulse_cloudflare_worker_errors{period=\"window\"}) or vector(0)) > 0",
          "legendFormat": "Worker errors",
          "refId": "H",
          "instant": true,
          "range": false
        },
        {
          "expr": "sum(tubepulse_cloudflare_worker_requests{period=\"window\",script!=\"tubepulse-api\"}) > 0",
          "legendFormat": "Legacy traffic",
          "refId": "I",
          "instant": true,
          "range": false
        },
        {
          "expr": "tubepulse_notifications_callback_pending > 0",
          "legendFormat": "Notification callbacks",
          "refId": "J",
          "instant": true,
          "range": false
        },
        {
          "expr": "tubepulse_notifications_ambiguous_sending > 0",
          "legendFormat": "Ambiguous sends",
          "refId": "K",
          "instant": true,
          "range": false
        },
        {
          "expr": "(1 - (tubepulse_collector_collection_success * tubepulse_collector_host_collection_success * tubepulse_host_ready * tubepulse_host_authority_current * tubepulse_host_scheduler_active * tubepulse_authority_backend_ready * tubepulse_notifications_barrier_healthy * (tubepulse_host_last_error_present == bool 0) * ((time() - tubepulse_collector_last_success_timestamp_seconds) < bool 960) * (scalar(sum(tubepulse_cloudflare_worker_errors{period=\"window\"}) or vector(0)) == bool 0) * (scalar(tubepulse:d1_write_budget_ratio) < bool 0.9) * (scalar(tubepulse:worker_request_budget_ratio) < bool 0.9) * (scalar(max(tubepulse_youtube_quota_used / tubepulse_youtube_quota_limit)) < bool 0.9))) > 0",
          "legendFormat": "Core availability",
          "refId": "L",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No active incidents",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6FCF97",
                "value": null
              },
              {
                "color": "#FFB74D",
                "value": 1
              },
              {
                "color": "#EF5350",
                "value": 1000
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Live checks"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Nothing needs attention",
                        "color": "#6FCF97"
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 1,
                      "to": 999,
                      "result": {
                        "text": "Review needed",
                        "color": "#FFB74D"
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 1000,
                      "to": 1000000,
                      "result": {
                        "text": "Service fault",
                        "color": "#EF5350"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Core availability"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#6FCF97",
                      "value": null
                    },
                    {
                      "color": "#EF5350",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Worker errors"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#6FCF97",
                      "value": null
                    },
                    {
                      "color": "#EF5350",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "wideLayout": true,
