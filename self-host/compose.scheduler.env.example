# Copy to .env.scheduler. Shadow is the only safe initial mode.
COMPOSE_PROJECT_NAME=tubepulse-home-scheduler
TUBEPULSE_HOME_SCHEDULER_MODE=shadow

# Production namespace read access is sufficient for shadow mode.
CLOUDFLARE_ACCOUNT_ID=77bb7769185bbfeb53feef16b9f72803
CLOUDFLARE_KV_NAMESPACE_ID=52e77ca9f5f6493e89d2478c8d3055ec
CLOUDFLARE_API_TOKEN_FILE=/run/secrets/tubepulse/cloudflare-read-token.txt
TUBEPULSE_HOME_SCHEDULER_CLOUDFLARE_TOKEN_HOST_FILE=./secrets/cloudflare-read-token.txt

FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/tubepulse/firebase.json
YOUTUBE_API_KEY_FILE=/run/secrets/tubepulse/youtube-api-key.txt
TUBEPULSE_HOME_SCHEDULER_FIREBASE_HOST_FILE=./secrets/firebase.json
TUBEPULSE_HOME_SCHEDULER_YOUTUBE_KEY_HOST_FILE=./secrets/youtube-api-key.txt
TUBEPULSE_HOME_SCHEDULER_GATEWAY_ADMIN_TOKEN_FILE=/run/secrets/tubepulse/gateway-admin-token.txt
TUBEPULSE_HOME_SCHEDULER_GATEWAY_ADMIN_TOKEN_HOST_FILE=./secrets/gateway-admin-token.txt

# Required for guarded active notification delivery. With the production API
# serving canonical Cloudflare KV directly, the default gate proves each queued
# item through that unchanged /feed path before FCM. Set the convergence flag
# true only while the production API routes reads through the Home gateway.
TUBEPULSE_HOME_SCHEDULER_GATEWAY_CONVERGENCE_REQUIRED=false
TUBEPULSE_HOME_SCHEDULER_GATEWAY_ADMIN_URL=http://host.docker.internal:8789/_tubepulse/admin/gateway/reconcile
TUBEPULSE_HOME_SCHEDULER_GATEWAY_RECONCILE_URL=https://tubepulse-api.jimothyoakley55.workers.dev/_tubepulse/gateway/reconcile
TUBEPULSE_HOME_SCHEDULER_API_URL=https://tubepulse-api.jimothyoakley55.workers.dev
TUBEPULSE_HOME_SCHEDULER_NOTIFICATION_BARRIER_TIMEOUT_SECONDS=20
TUBEPULSE_HOME_SCHEDULER_NOTIFICATION_BARRIER_RETRY_COUNT=2
TUBEPULSE_HOME_SCHEDULER_NOTIFICATION_BARRIER_RETRY_BACKOFF_MS=1000

TUBEPULSE_HOME_SCHEDULER_CONCURRENCY=6
TUBEPULSE_HOME_SCHEDULER_SYNC_CONCURRENCY=6
TUBEPULSE_HOME_SCHEDULER_CHANNEL_TIMEOUT_SECONDS=25
TUBEPULSE_HOME_SCHEDULER_RETRY_COUNT=2
TUBEPULSE_HOME_SCHEDULER_RETRY_BACKOFF_MS=1000
TUBEPULSE_HOME_SCHEDULER_LEASE_TTL_SECONDS=180
TUBEPULSE_HOME_SCHEDULER_POSTS_CADENCE_MINUTES=60
TUBEPULSE_HOME_SCHEDULER_POSTS_CONCURRENCY=4
TUBEPULSE_HOME_SCHEDULER_POSTS_MAX_RESPONSE_BYTES=2097152
# Five-minute posts are deliberately off; both lines are required only after a
# live quota review. The production candidate remains the 60-minute default.
# TUBEPULSE_HOME_SCHEDULER_ALLOW_5M_POSTS=true
# TUBEPULSE_HOME_SCHEDULER_5M_POSTS_LATCH=YOUTUBE_QUOTA_BUDGET_CONFIRMED
TUBEPULSE_YOUTUBE_DAILY_QUOTA_UNITS=10000
TUBEPULSE_HOME_SCHEDULER_YOUTUBE_QUOTA_RESERVE_UNITS=1000
TUBEPULSE_ENABLE_COMMUNITY_POSTS=true

# These controls must remain false/absent. The first production exercise was
# rolled back: direct-canonical polling exceeded the free-tier read model and
# could race app mutations. Active startup is now blocked in code until the
# documented unified local-first authority is implemented and validated.
TUBEPULSE_HOME_SCHEDULER_REMOTE_WRITE_ENABLED=false
TUBEPULSE_HOME_SCHEDULER_NOTIFICATIONS_ENABLED=false
TUBEPULSE_CLOUDFLARE_SCHEDULES_CONFIRMED_DISABLED=false
# TUBEPULSE_HOME_SCHEDULER_ACTIVATION_LATCH=CLOUDFLARE_SCHEDULES_CONFIRMED_DISABLED
