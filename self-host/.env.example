# TubePulse self-host preview. Copy to .env; never commit the real file.

# standalone: this machine is authoritative and schedulers start immediately.
# mirror: schedulers remain on standby until takeover; Cloudflare pull is optional.
TUBEPULSE_MODE=standalone

# Leave false for ordinary standalone/mirror operation. The committed
# compose.pilot.env profile forces this true and supplies the other pilot
# safeguards without modifying this ignored local file.
TUBEPULSE_PILOT=false

# Loopback is the safe default for Node. Docker Compose overrides this inside
# the container while publishing the host port to 127.0.0.1 only.
TUBEPULSE_HOST=127.0.0.1
TUBEPULSE_PORT=8788
TUBEPULSE_DATA_DIR=./data

# Docker host publishing remains loopback-only unless this separate setting is
# intentionally changed. Use 0.0.0.0 only with a narrowly scoped firewall rule.
TUBEPULSE_PUBLISH_ADDRESS=127.0.0.1
# Compose host-data source. The pilot profile overrides this to ./data-pilot.
TUBEPULSE_HOST_DATA_DIR=./data

# Required for takeover/standby/sync admin commands. Generate a long random
# value. Prefer TUBEPULSE_ADMIN_TOKEN_FILE on a multi-user host.
TUBEPULSE_ADMIN_TOKEN=
# TUBEPULSE_ADMIN_TOKEN_FILE=C:\secure\tubepulse-admin-token.txt

# Worker credentials. File variants avoid multiline JSON in .env.
# Required for push notifications once scheduled jobs find recipients.
FIREBASE_SERVICE_ACCOUNT_FILE=
# Required for handle resolution and the API bootstrap fallback. Prefer the
# file setting for Docker and shared hosts.
YOUTUBE_API_KEY=
# YOUTUBE_API_KEY_FILE=/run/secrets/tubepulse/youtube-api-key.txt

# Cloudflare mirror synchronization (all three are required together).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN_FILE=
# CLOUDFLARE_API_TOKEN=

# Mirror safety defaults.
TUBEPULSE_SYNC_PULL_INTERVAL_SECONDS=1800
TUBEPULSE_SYNC_CONCURRENCY=4
TUBEPULSE_AUTO_TAKEOVER=false
TUBEPULSE_CLOUDFLARE_WRITE_ENABLED=false
TUBEPULSE_SYNC_AUTO_PUSH=false

# Existing-app canary gateway origin (experimental, disabled by default).
# This is a mirror/standby, pull-only role: Cloudflare remains authoritative;
# auto takeover, Cloudflare writes/push, and Home notifications stay disabled.
# Do not enable it in the isolated pilot.
TUBEPULSE_GATEWAY_ORIGIN_ENABLED=false
# Use one shared random value of at least 32 characters on the API Worker and
# Home. Prefer the file variant on this host.
# TUBEPULSE_HOME_GATEWAY_SECRET_FILE=/run/secrets/tubepulse/gateway-secret.txt
# Load only deviceFingerprintSha256 from the ignored JSON file. A raw 64-hex
# file or TUBEPULSE_HOME_CANARY_SHA256 is also accepted.
# TUBEPULSE_HOME_CANARY_SHA256_FILE=/run/secrets/tubepulse/canary-device.json
# TUBEPULSE_GATEWAY_RECONCILE_URL=https://tubepulse-api.example.workers.dev/_tubepulse/gateway/reconcile
# TUBEPULSE_GATEWAY_RECONCILE_TIMEOUT_SECONDS=10
TUBEPULSE_GATEWAY_CLOCK_SKEW_SECONDS=60
# Defaults to twice the configured pull interval when omitted.
# TUBEPULSE_GATEWAY_READINESS_MAX_AGE_SECONDS=3600

# Existing Worker feature bindings.
TUBEPULSE_ENABLE_COMMUNITY_POSTS=true
# Host-only, rollback-safe aligned video notification owner (default off).
# Current production sets true only in ignored .env.authority.
TUBEPULSE_HOME_ALIGNED_VIDEO_NOTIFICATIONS_ENABLED=false
# Default-off precision insurance; current production sets true only in ignored .env.authority.
TUBEPULSE_HOME_PRECISE_LIVE_WATCH_ENABLED=false
# Pacific-day sub-cap; exhaustion falls back to ordinary five-minute detection.
TUBEPULSE_HOME_PRECISE_LIVE_WATCH_DAILY_CAP=2000
# TUBEPULSE_COMMUNITY_POST_CHANNEL_ALLOWLIST=
# TUBEPULSE_DEBUG_COMMUNITY_POSTS=false

# Used by CLI commands when the listener is not on the default URL.
# TUBEPULSE_SELF_HOST_URL=http://127.0.0.1:8788

# Android/Expo build-time values belong in the app build environment, not the
# self-host process environment:
# EXPO_PUBLIC_TUBEPULSE_API_URL=https://primary.example
# EXPO_PUBLIC_TUBEPULSE_FALLBACK_API_URL=https://fallback.example
