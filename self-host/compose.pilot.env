# Non-secret interpolation settings for the isolated LAN Preview pilot.
# The service still reads credentials and API keys from the ignored .env and
# secrets/ files, but TUBEPULSE_PILOT makes Cloudflare sync unavailable and
# refuses unsafe scheduler/write modes at runtime.
COMPOSE_PROJECT_NAME=tubepulse-pilot
TUBEPULSE_HOST_DATA_DIR=./data-pilot
TUBEPULSE_PUBLISH_ADDRESS=0.0.0.0
TUBEPULSE_PILOT=true
TUBEPULSE_MODE=standalone
TUBEPULSE_AUTO_TAKEOVER=false
TUBEPULSE_CLOUDFLARE_WRITE_ENABLED=false
TUBEPULSE_SYNC_AUTO_PUSH=false
