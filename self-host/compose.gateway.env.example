# Copy to .env.gateway only after provisioning the ignored secret files.
# The gateway origin is a separate mirror and never uses data-pilot or data.

COMPOSE_PROJECT_NAME=tubepulse-home
TUBEPULSE_GATEWAY_STATUS_PORT=8789

CLOUDFLARE_ACCOUNT_ID=77bb7769185bbfeb53feef16b9f72803
CLOUDFLARE_KV_NAMESPACE_ID=52e77ca9f5f6493e89d2478c8d3055ec
CLOUDFLARE_API_TOKEN_FILE=/run/secrets/tubepulse/cloudflare-read-token.txt

TUBEPULSE_ADMIN_TOKEN_FILE=/run/secrets/tubepulse/gateway-admin-token.txt
TUBEPULSE_HOME_GATEWAY_SECRET_FILE=/run/secrets/tubepulse/gateway-secret.txt
TUBEPULSE_HOME_CANARY_SHA256_FILE=/run/secrets/tubepulse/canary-device.json

TUBEPULSE_SYNC_PULL_INTERVAL_SECONDS=300
TUBEPULSE_SYNC_CONCURRENCY=4
TUBEPULSE_GATEWAY_CLOCK_SKEW_SECONDS=60
TUBEPULSE_GATEWAY_READINESS_MAX_AGE_SECONDS=600
# Exact API endpoint that accepts the signed post-pull reconciliation receipt.
# HTTPS is mandatory outside explicit local tests.
TUBEPULSE_GATEWAY_RECONCILE_URL=https://tubepulse-api.example.workers.dev/_tubepulse/gateway/reconcile
TUBEPULSE_GATEWAY_RECONCILE_TIMEOUT_SECONDS=10

# Optional for mutation parity when a newly subscribed channel requires the
# API's YouTube fallback. The mirror scheduler remains stopped.
YOUTUBE_API_KEY_FILE=/run/secrets/tubepulse/youtube-api-key.txt

# Digest-pinned cloudflared 2026.9.3. Update only after reviewing release notes.
TUBEPULSE_CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:072c067d25ccbe61d46e18f0d0723255f2bb5304f7317caa95b27031520ff92c
