# Dependencies
node_modules/

# Expo
.expo/

# Build artifacts
*.apk
*.aab

# Local release outputs
dist/
releases/
*.sha256
*.log
release-manifest*.json
release-notes*.md

# Android local properties (machine-specific paths, e.g. ndk.dir)
android/local.properties

# Wrangler local secrets
# .dev.vars is read by wrangler dev and deploy --dry-run; never commit
.dev.vars
.dev.vars.*
worker/*/.dev.vars
worker/*/.wrangler/
.wrangler/

# Self-host runtime state and local configuration
self-host/.env
self-host/.env.gateway
self-host/data/
self-host/data-gateway/
self-host/data-pilot/
self-host/data-scheduler/
self-host/data-authority/
self-host/secrets/
self-host/.env.scheduler
self-host/.env.authority

# Local aggregate monitoring history/state. Keep only the operator entrypoints.
/logs/*
!/logs/README.md
!/logs/Open-TubePulse-Operations.ps1
!/logs/Open-TubePulse-Operations.cmd
/monitoring/.env.local

# Generated only while assembling the side-by-side local Android variant.
android/app/src/selfhost/google-services.json

# Local secrets and credentials
# CRITICAL: anything under secrets/ is live credentials - NEVER commit
/secrets/
**/secrets/
secrets/cloudflare.env
secrets/youtube.env
secrets/fcm-service-account.json
secrets/*.env
secrets/*.json
secrets/*.key
secrets/*.pem

# Service-account / Firebase artefacts
worker/tubepulse-fcm-service-account.json
.firebaserc
firebase-debug.log

# Generated repo inventory files
repo-structure.txt
repo-files-git-tracked.txt
repo-status-ignored.txt

# Editor / OS
.DS_Store
*.swp
*.swo
*.bak
*.bak.*
.idea/
.vscode/

# Firebase / Google client config (public per Google docs but untracked
# here so a regenerating the file doesn't trip us up. The file is still
# on disk and required for the Android build to work - see app.json's
# android.googleServicesFile setting)
google-services.json
GoogleService-Info.plist

# Aider
.aider*
.cmdline-tools/

# KV dumps and other root-level text files
/*.txt
patches/
