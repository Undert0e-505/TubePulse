{
  "name": "tubepulse",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check:worker-api": "node --check worker/tubepulse-api/index.js",
    "check:worker-cron": "node --check worker/tubepulse-cron/index.js",
    "check:worker-scheduled": "node --check worker/tubepulse-cron/shared.mjs && node --check worker/tubepulse-rss-0/index.js && node --check worker/tubepulse-rss-1/index.js && node --check worker/tubepulse-rss-2/index.js && node --check worker/tubepulse-posts/index.js && node --check worker/tubepulse-posts/community-posts.mjs && node --check worker/tubepulse-aux/index.js",
    "test:worker-rotation": "node worker/test-scheduled-worker-rotation.mjs",
    "test:worker-aux": "node --test worker/test-aux-nags.mjs",
    "test:worker-rss-merge": "node worker/test-rss-recent-merge.mjs",
    "test:worker-rss-watermark": "node worker/tubepulse-rss-0/test-rss-watermark.mjs",
    "test:worker-api-avatar": "node --test worker/test-api-avatar-repair.mjs",
    "test:worker-api-metrics": "node --test worker/test-api-video-metrics.mjs",
    "test:worker-api-registration": "node --test worker/test-api-registration-capability.mjs",
    "test:worker-api-gateway": "node --test worker/test-api-gateway.mjs",
    "test:worker-api-authority": "node --test worker/test-api-authority.mjs",
    "test:worker-api-d1": "node --test worker/test-d1-kv.mjs",
    "check:workers": "npm run check:worker-api && npm run check:worker-cron && npm run check:worker-scheduled && npm run test:worker-api-avatar && npm run test:worker-api-metrics && npm run test:worker-api-registration && npm run test:worker-api-gateway && npm run test:worker-api-authority && npm run test:worker-api-d1 && npm run test:worker-rotation && npm run test:worker-aux && npm run test:worker-rss-merge && npm run test:worker-rss-watermark",
    "check:community-posts": "node scripts/test-community-post-parser.js",
    "test:preview-endpoint": "node --test test/preview-endpoint.test.mjs",
    "test:device-id": "node --test test/device-id.test.mjs",
    "test:channel-bootstrap": "node --test test/channel-bootstrap.test.mjs",
    "test:app-initialization": "node --test test/app-initialization.test.mjs",
    "test:app-registration": "node --test test/app-registration.test.mjs",
    "test:video-metrics": "node --test test/video-metrics.test.mjs",
    "test:seen-persistence": "node --test test/seen-persistence.test.mjs",
    "test:channel-ordering": "node --test test/channel-ordering.test.mjs",
    "test:notification-taps": "node --test test/notification-tap.test.mjs",
    "test:settings-cog": "node --test test/settings-cog.test.mjs",
    "test:settings-footer": "node --test test/settings-footer.test.mjs",
    "test:channel-dnd-settings": "node --test test/channel-dnd-settings.test.mjs",
    "test:widget-presentation": "node --test test/widget-presentation.test.mjs",
    "test:monitoring": "node --test monitoring/test/*.test.mjs",
    "check:monitoring": "node --check monitoring/src/cloudflare.mjs && node --check monitoring/src/collector.mjs && node --check monitoring/src/prometheus.mjs && node --check monitoring/src/snapshots.mjs && npm run test:monitoring",
    "check:self-host": "npm --prefix self-host run check",
    "build:android:selfhost": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Build-SelfHostApk.ps1"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/messaging": "^24.0.0",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "expo": "~54.0.33",
    "expo-application": "~7.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-secure-store": "~14.2.3",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-android-widget": "^0.20.1",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "0.5.1"
  },
  "license": "MIT",
  "keywords": [
    "youtube",
    "notifications",
    "android",
    "react-native",
    "expo",
    "firebase",
    "fcm",
    "cloudflare-workers",
    "push-notifications",
    "community-posts",
    "self-hosted"
  ],
  "private": true,
  "devDependencies": {
    "babel-preset-expo": "~54.0.10"
  }
}
