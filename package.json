{
  "name": "tubepulse",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check:worker-api": "node --check worker/tubepulse-api/index.js",
    "check:worker-cron": "node --check worker/tubepulse-cron/index.js",
    "check:worker-scheduled": "node --check worker/tubepulse-cron/shared.mjs && node --check worker/tubepulse-rss-0/index.js && node --check worker/tubepulse-rss-1/index.js && node --check worker/tubepulse-rss-2/index.js && node --check worker/tubepulse-posts/index.js && node --check worker/tubepulse-posts/community-posts.mjs && node --check worker/tubepulse-aux/index.js",
    "test:worker-rotation": "node worker/test-scheduled-worker-rotation.mjs",
    "test:worker-rss-watermark": "node worker/tubepulse-rss-0/test-rss-watermark.mjs",
    "check:workers": "npm run check:worker-api && npm run check:worker-cron && npm run check:worker-scheduled && npm run test:worker-rotation && npm run test:worker-rss-watermark",
    "check:community-posts": "node scripts/test-community-post-parser.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/messaging": "^24.0.0",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "expo": "~54.0.33",
    "expo-application": "~7.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-secure-store": "~14.2.3",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-android-widget": "^0.20.1",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "0.5.1"
  },
  "license": "MIT",
  "keywords": [
    "youtube",
    "notifications",
    "android",
    "react-native",
    "expo",
    "firebase",
    "fcm",
    "cloudflare-workers",
    "push-notifications",
    "community-posts",
    "self-hosted"
  ],
  "private": true,
  "devDependencies": {
    "babel-preset-expo": "~54.0.10"
  }
}
